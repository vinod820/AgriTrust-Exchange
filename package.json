{
  "name": "agri-market-hackathon",
  "private": true,
  "workspaces": [
    "apps/web",
    "contracts",
    "services/signaling"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace apps/web",
    "dev:contracts": "npm run dev --workspace contracts",
    "dev:ai": "uvicorn app.main:app --reload --host 0.0.0.0 --port 8001 --app-dir services/ai",
    "dev:signaling": "npm run dev --workspace services/signaling",
    "lint:web": "npm run lint --workspace apps/web",
    "build:web": "npm run build --workspace apps/web",
    "test:contracts": "npm run test --workspace contracts"
  }
}
